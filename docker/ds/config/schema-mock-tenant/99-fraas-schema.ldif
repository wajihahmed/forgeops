attributeTypes: ( 1.3.6.1.4.1.36733.2.4.1.204 NAME 'fr-idm-inviteOTPCount'
  DESC 'Positive integer used to count the number of OTP invites sent, and reject further attempts when it goes over a threshold'
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.27
  EQUALITY integerMatch
  SINGLE-VALUE
  X-ORIGIN 'ForgeRock Identity Cloud' )
objectClasses: ( 1.3.6.1.4.1.36733.2.4.2.1 NAME 'fraas-admin'
    SUP top
    AUXILIARY
    MAY ( inetUserStatus $
          fr-idm-inviteDate $
          fr-idm-inviteOTPCount $
          fr-idm-jurisdiction $
          fr-idm-onboardDate $
          fr-attr-group )
    X-STABILITY 'Internal'
    X-ORIGIN 'ForgeRock Identity Cloud' )
