# Additional objectclass to add to your user to get these attributes
objectClasses: (  1.3.6.1.4.1.36733.2.4.2.3 NAME 'fr-ext-attrs'
  SUP top
  AUXILIARY
  MAY ( fr-attr-istr1 $
        fr-attr-istr2 $
