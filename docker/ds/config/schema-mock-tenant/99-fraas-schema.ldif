# objectclass for service accounts
objectClasses: (  1.3.6.1.4.1.36733.2.4.2.4 NAME 'fr-id-cloud-svc-acct'
  SUP top
  STRUCTURAL
  MUST ( cn $
         fr-attr-jwks $
         fr-attr-scope $
         fr-idm-uuid $
         inetUserStatus
         )
  MAY ( fr-attr-description )
  X-STABILITY 'Internal'
