# Virtual attributes — compute memberURL dynamically from fr-idm-effectiveGroup
dsconfig --offline --no-prompt --batch <<EOF
create-virtual-attribute \
        --name "virtual root group memberURL" \
        --type user-template \
        --set base-dn:ou=groups,o=root,ou=identities \
        --set enabled:true \
        --set attribute-type:memberURL \
        --set template:"ldap:///ou=people,o=root,ou=identities??sub?fr-idm-effectiveGroup:caseIgnoreJsonQueryMatch:=_refResourceId eq \"{cn}\"" \
        --set conflict-behavior:merge-real-and-virtual \
        --set filter:(&(objectClass=top)(objectClass=groupOfURLs)(objectClass=fr-idm-managed-group))
create-virtual-attribute \
        --name "virtual alpha group memberURL" \
        --type user-template \
        --set base-dn:ou=groups,o=alpha,o=root,ou=identities \
        --set enabled:true \
        --set attribute-type:memberURL \
        --set template:"ldap:///ou=user,o=alpha,o=root,ou=identities??sub?fr-idm-effectiveGroup:caseIgnoreJsonQueryMatch:=_refResourceId eq \"{cn}\"" \
        --set conflict-behavior:virtual-overrides-real \
        --set filter:(&(objectClass=top)(objectClass=groupOfURLs)(objectClass=fr-idm-managed-group))
create-virtual-attribute \
        --name "virtual bravo group memberURL" \
        --type user-template \
        --set base-dn:ou=groups,o=bravo,o=root,ou=identities \
        --set enabled:true \
        --set attribute-type:memberURL \
        --set template:"ldap:///ou=user,o=bravo,o=root,ou=identities??sub?fr-idm-effectiveGroup:caseIgnoreJsonQueryMatch:=_refResourceId eq \"{cn}\"" \
        --set conflict-behavior:virtual-overrides-real \
        --set filter:(&(objectClass=top)(objectClass=groupOfURLs)(objectClass=fr-idm-managed-group))
set-virtual-attribute-prop \
        --name isMemberOf \
        --set filter:(|(objectClass=person)(objectClass=groupOfNames)(objectClass=groupOfUniqueNames)(objectClass=groupOfEntries)(objectClass=fr-id-cloud-svc-acct))
EOF

# Unique-attribute plugins — enforce uid and application name uniqueness per realm
dsconfig --offline --no-prompt --batch <<EOF
create-plugin \
        --plugin-name "Alpha Username Unique Attribute" \
        --type "unique-attribute" \
        --set "type:uid" \
        --set "base-dn:ou=user,o=alpha,o=root,ou=identities" \
        --set "enabled:true"
create-plugin \
        --plugin-name "Bravo Username Unique Attribute" \
        --type "unique-attribute" \
        --set "type:uid" \
        --set "base-dn:ou=user,o=bravo,o=root,ou=identities" \
        --set "enabled:true"
create-plugin \
        --plugin-name "Alpha Application Name Unique Attribute" \
        --type "unique-attribute" \
        --set "type:fr-idm-managed-application-name" \
        --set "base-dn:ou=application,o=alpha,o=root,ou=identities" \
        --set "enabled:true"
create-plugin \
        --plugin-name "Bravo Application Name Unique Attribute" \
        --type "unique-attribute" \
        --set "type:fr-idm-managed-application-name" \
        --set "base-dn:ou=application,o=bravo,o=root,ou=identities" \
        --set "enabled:true"
EOF

echo "Done."